# JDK used for both the Maven build stage and the runtime stage. CI passes
# --build-arg JAVA_VERSION=<N> to test the app on other Java versions.
ARG JAVA_VERSION=21

# Stage that builds the application, a prerequisite for the running stage
FROM maven:3-eclipse-temurin-${JAVA_VERSION} AS build

# Optional Vaadin version override. Empty (default) builds the pom-pinned
# version; CI passes --build-arg VAADIN_VERSION=<X.Y> to test other versions.
ARG VAADIN_VERSION=

# Optional Flow version override, independent of the platform version. Used to
# build against a Flow branch snapshot, e.g.
# --build-arg FLOW_VERSION=25.4.sse2-SNAPSHOT for the SSE push transport.
ARG FLOW_VERSION=

# The Node.js that Flow 25.4 downloads (26.x) links against libatomic, which
# the Maven base image does not ship. Without it `node --version` exits with 127
# and build-frontend fails. The package version is left to the base image.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends libatomic1 \
    && rm -rf /var/lib/apt/lists/*

# Stop running as root at this point. The uid is pinned and USER names it by
# number: a host (or hadolint's DL3066) cannot resolve a name out of the image's
# own /etc/passwd. 1001 is what `useradd -m myuser` picks anyway on these
# Ubuntu-based bases, where 1000 is already taken by `ubuntu`.
RUN useradd -m -u 1001 myuser
WORKDIR /usr/src/app/
RUN chown myuser:myuser /usr/src/app/
USER 1001

# Copy pom.xml and prefetch dependencies so a repeated build can continue from the next step with existing dependencies
COPY --chown=myuser pom.xml ./
RUN mvn -ntp dependency:go-offline

# Copy all needed project files to a folder
COPY --chown=myuser:myuser src src
COPY --chown=myuser:myuser src/main/frontend frontend
COPY --chown=myuser:myuser package.json ./

# Using * after the files that are autogenerated so that so build won't fail if they are not yet created
COPY --chown=myuser:myuser package-lock.json* pnpm-lock.yaml* webpack.config.js* vite.config.js* ./

# Build the production package, assuming that we validated the version before so no need for running tests again
RUN mvn -ntp clean package -DskipTests ${VAADIN_VERSION:+-Dvaadin.version=$VAADIN_VERSION} ${FLOW_VERSION:+-Dflow.version=$FLOW_VERSION}

# Running stage: the part that is used for running the application
FROM eclipse-temurin:${JAVA_VERSION}
COPY --from=build /usr/src/app/target/*.jar /usr/app/app.jar
RUN useradd -m -u 1001 myuser
USER 1001
EXPOSE 8080
CMD [ "java", "-jar", "/usr/app/app.jar" ]
